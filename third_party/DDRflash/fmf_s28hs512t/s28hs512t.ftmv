<TIMING>
(DELAY (ABSOLUTE
    (COND  ~OPI_IT && ~glitch (IOPATH SCK SO  (2:2.3:8) (2:2.3:8) () (2:2.3:8) () (2:2.3:8)))
    (COND  ~OPI_IT && ~glitch (IOPATH SCK SI  (2:2.3:8) (2:2.3:8) () (2:2.3:8) () (2:2.3:8)))
    (COND  ~OPI_IT && ~glitch (IOPATH SCK IO2 (2:2.3:8) (2:2.3:8) () (2:2.3:8) () (2:2.3:8)))
    (COND  ~OPI_IT && ~glitch (IOPATH SCK IO3 (2:2.3:8) (2:2.3:8) () (2:2.3:8) () (2:2.3:8)))
    (COND  ~OPI_IT && ~glitch (IOPATH SCK IO4 (2:2.3:8) (2:2.3:8) () (2:2.3:8) () (2:2.3:8)))
    (COND  ~OPI_IT && ~glitch (IOPATH SCK IO5 (2:2.3:8) (2:2.3:8) () (2:2.3:8) () (2:2.3:8)))
    (COND  ~OPI_IT && ~glitch (IOPATH SCK IO6 (2:2.3:8) (2:2.3:8) () (2:2.3:8) () (2:2.3:8)))
    (COND  ~OPI_IT && ~glitch (IOPATH SCK IO7 (2:2.3:8) (2:2.3:8) () (2:2.3:8) () (2:2.3:8)))
    
    (COND   OPI_IT && ~glitch  (IOPATH SCK SO  (2:2.3:5.45) (2:2.3:5.45) () (2:2.3:5.45) () (2:2.3:5.45)))
    (COND   OPI_IT && ~glitch  (IOPATH SCK SI  (2:2.3:5.45) (2:2.3:5.45) () (2:2.3:5.45) () (2:2.3:5.45)))
    (COND   OPI_IT && ~glitch  (IOPATH SCK IO2 (2:2.3:5.45) (2:2.3:5.45) () (2:2.3:5.45) () (2:2.3:5.45)))
    (COND   OPI_IT && ~glitch  (IOPATH SCK IO3 (2:2.3:5.45) (2:2.3:5.45) () (2:2.3:5.45) () (2:2.3:5.45)))
    (COND   OPI_IT && ~glitch  (IOPATH SCK IO4 (2:2.3:5.45) (2:2.3:5.45) () (2:2.3:5.45) () (2:2.3:5.45)))
    (COND   OPI_IT && ~glitch  (IOPATH SCK IO5 (2:2.3:5.45) (2:2.3:5.45) () (2:2.3:5.45) () (2:2.3:5.45)))
    (COND   OPI_IT && ~glitch  (IOPATH SCK IO6 (2:2.3:5.45) (2:2.3:5.45) () (2:2.3:5.45) () (2:2.3:5.45)))
    (COND   OPI_IT && ~glitch  (IOPATH SCK IO7 (2:2.3:5.45) (2:2.3:5.45) () (2:2.3:5.45) () (2:2.3:5.45)))   

    (IOPATH CSNeg SO  () () (2:4:6) () (2:4:6) ())
    (IOPATH CSNeg SI  () () (2:4:6) () (2:4:6) ())
    (IOPATH CSNeg IO2 () () (2:4:6) () (2:4:6) ())
    (IOPATH CSNeg IO3 () () (2:4:6) () (2:4:6) ())
    (IOPATH CSNeg IO4 () () (2:4:6) () (2:4:6) ())
    (IOPATH CSNeg IO5 () () (2:4:6) () (2:4:6) ())
    (IOPATH CSNeg IO6 () () (2:4:6) () (2:4:6) ())
    (IOPATH CSNeg IO7 () () (2:4:6) () (2:4:6) ())
    
    (COND OPI_IT && ~glitch  (IOPATH SCK DS  (2:2.3:5.45) (2:2.3:5.45) () (2:2.3:5.45) () (2:2.3:5.45)))
    
    (IOPATH CSNeg DS  () () (2:4:10) (2:4:10) (2:4:10) (2:4:10))
  ))
(TIMINGCHECK
    (SETUP (COND NegOPI_NegF51M CSNeg) (posedge SCK) (5))
    (SETUP (COND NegOPI_F51M CSNeg) (posedge SCK) (4))
    (SETUP (COND osdr CSNeg) SCK (4))
    (SETUP (COND oddr CSNeg) SCK (4))


    (SETUP (COND NegOPI_F51M    SI) (posedge SCK) (2))
    (SETUP (COND NegOPI_NegF51M SI)( posedge SCK) (5))
    (SETUP (COND odatain SI )       (posedge SCK)(0.5))
    (SETUP (COND odatain_ddr SI)    SCK (0.5))

    (SETUP RESETNeg CSNeg (50))

    (HOLD (COND  ~mode3   CSNeg) SCK (4))
    (HOLD (COND   mode3sdr CSNeg) SCK (6.5))
    (HOLD (COND   mode3spi CSNeg) SCK (6))
    
    (HOLD (COND NegOPI_F51M    SI) (posedge SCK) (2))
